# Monday-morning memo that reads across every job's shared entries (open loops,
# stale items, events, transcript-miner suggestions) and narrates the week back
# to you. Plain code builds the digest; one model pass writes it up.
JOB_NAME="weekly-review"
JOB_DESCRIPTION="Monday memo compiled from what all your jobs tracked this week"

SCHEDULE="30 8 * * 1"

JOB_GATED=0
JOB_MODEL="sonnet"
JOB_TIMEOUT=1200
CATCHUP_WINDOW="72h"

ARTIFACT_GLOB="*.md"
JOB_ICON="calendar-days"

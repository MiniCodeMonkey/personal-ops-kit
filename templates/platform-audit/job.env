# The platform watching itself: reads every job's run ledger and turns quiet or
# failing streaks into flags plus a monthly memo. Pure code, no model.
JOB_NAME="platform-audit"
JOB_DESCRIPTION="Monthly report on how your jobs have actually been running"

SCHEDULE="45 8 1 * *"

JOB_GATED=0
JOB_TIMEOUT=300
CATCHUP_WINDOW="168h"

ARTIFACT_GLOB="*.md"
JOB_ICON="shield-check"

# Self-directed nightly research. Picks one of your lanes (lanes/*.md), works
# unattended inside the OS sandbox, and leaves an HTML memo for the morning.
JOB_NAME="nightly-research"
JOB_DESCRIPTION="Researches one of your topics each evening and leaves a memo"

SCHEDULE="0 19 * * *"

# Gated: the biggest spend here, so it skips the night when this week's Claude
# usage is already at or above GATE_THRESHOLD percent. Set JOB_GATED=0 to always run.
JOB_GATED=1
GATE_THRESHOLD=60

# "opus" gives deeper memos at a higher cost; the gate above keeps that in check.
JOB_MODEL="opus"
JOB_TIMEOUT=3000

# Optional: run on a different Claude Code profile than your default, if you keep
# several (for example a work account). The gate then reads that profile's usage.
# CLAUDE_PROFILE_DIR="$HOME/.claude-work"

ARTIFACT_GLOB="*.html"
JOB_ICON="beaker"

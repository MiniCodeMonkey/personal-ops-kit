# Weekly sweep of your Claude Code session transcripts: corrections you gave more
# than once (should become memory or CLAUDE.md) and workflows you walked Claude
# through repeatedly (should become a skill). Mostly plain code; one model pass.
JOB_NAME="transcript-miner"
JOB_DESCRIPTION="Tips from your own Claude Code sessions: repeated corrections and skill candidates"

SCHEDULE="30 7 * * 1"

# One short pass over a small digest, so it is not gated.
JOB_GATED=0
JOB_MODEL="sonnet"
JOB_TIMEOUT=1800
CATCHUP_WINDOW="72h"

ARTIFACT_GLOB="*.md"
JOB_ICON="document-magnifying-glass"

# Your personal ops settings. install.sh creates ~/.config/personal-ops/config.env
# from this file once and never overwrites it. Re-run the installer (or
# `jobctl update`) after changing it.

# Where your jobs live. Can be its own private git repository.
OPS_JOBS="$HOME/personal-ops"

# Where job output (memos, logs, run history) goes.
OPS_ARTIFACTS="$HOME/ops"

# 0 = no macOS notifications; the dashboard still shows every result.
OPS_NOTIFICATIONS=1
